---
import '@fontsource-variable/geist';
import '../styles/app.css';
import { icon } from '../scripts/icons';
import { slash } from '../scripts/slash';
import { readFileSync } from 'node:fs';
import geistFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
// The in-app mark: the slashkern pointer (public/brand/mark.svg: navy body, ice eyes) on light grounds, and its reversed version (mark-rev.svg: cream body, navy eyes) on the navy blocks
// (the welcome screen, the Slash card). One drawing for the header, the launch screen, the first screens and the login. The wordmark is the lowercase "slashkern" beside it, in the UI font.
const MARK = '<img class="k-lg" src="/brand/mark.svg" width="235" height="271" alt="" />';
const MARK_REV = '<img class="k-lg" src="/brand/mark-rev.svg" width="235" height="271" alt="" />';
// Inlined so iOS can read it without a login cookie (it fetches the icon itself, which a password-protected site answers with 401).
const touchIcon = 'data:image/png;base64,' + readFileSync('public/icons/apple-touch-icon.png').toString('base64');
// Link previews (chat apps, social) need a full address for the image: Netlify gives the site's main address as URL while it builds (a local build has none, so the path stays relative).
const site = (process.env.URL ?? '').replace(/\/$/, '');
// Each field with one plain line under its name on the picker: what you do in it (Italian in i18n.ts).
const FIELDS = [['Design', 'Make things clear at a glance'], ['Writing', 'Words people actually read'], ['Code', 'Tell a computer what to do'], ['Video', 'Plan and cut short clips'], ['Selling', 'Sell your own things: listings, DMs, haggling'], ['Music', 'Pick sounds for a mood'], ['Prompting', 'Tell an AI exactly what you want']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>slashkern · Make something companies can hire you for</title>
    <meta name="description" content="Make short projects with Slash, an AI that asks one question at a time, keep them on your own page and let companies find them. Early access, free, no account." />
    <meta name="theme-color" content="#F5F7FF" />
    <script is:inline src="/theme-init.js"></script>
    <link rel="preload" as="font" type="font/woff2" href={geistFont} crossorigin />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href={touchIcon} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="slashkern" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="slashkern" />
    <meta property="og:description" content="Make short projects with Slash, an AI that asks one question at a time, keep them on your own page and let companies find them. Early access, free, no account." />
    <meta property="og:image" content={`${site}/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Don't guess your passion. Test it." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <main class="k-scr" id="kScr">
      <h1 class="k-sr">slashkern</h1>
      <div class="k-load" id="kLoad" aria-hidden="true">
        <div class="k-lock"><div class="k-ic" set:html={MARK} /><div class="k-wm">slashkern</div></div>
      </div>

      <div class="k-sheet" id="kSheet" role="dialog" aria-modal="true" aria-labelledby="kShT" hidden>
        <div class="k-sh-in">
          <div class="k-grab" aria-hidden="true"></div>
          <div class="k-shbar">
            <div class="k-prog" id="kProg" role="progressbar" aria-label="Project progress" aria-valuemin="1" aria-valuemax="3" aria-valuenow="1"><i><b></b></i><i><b></b></i><i><b></b></i></div>
            <div class="k-shh"><button type="button" class="k-shx" id="kShClose" aria-label="Close"><svg class="k-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg></button><div class="k-l" id="kShL">Project 002 · startup partner</div></div>
          </div>
          <h5 id="kShT">Fix what already exists</h5>
          <div class="k-step" id="kShA">
            <div class="k-x" id="kShX">
              <div class="k-xm"><span class="k-l" id="kXWho"></span><span class="k-l" id="kXMin"></span></div>
              <div class="k-boost-chip" id="kXBoost" hidden></div>
              <p class="k-xb" id="kXBrief"></p>
              <div class="k-xa"><div class="k-l" id="kXAT"></div><img class="k-xi" id="kXAI" alt="" hidden decoding="async" /><video class="k-xv" id="kXAV" controls playsinline preload="metadata" hidden></video><p class="k-l k-s" id="kXAVC" hidden>Clip made with AI for slashkern. Everything in it is fictional.</p><pre id="kXAB"></pre></div>
            </div>
            <p class="k-l k-s k-coop-hint" id="kCoopHint" hidden>Co-op project: answer it, then send it to a friend to finish together.</p>
            <div class="k-x" id="kShP">
              <div class="k-xh"><span class="k-l" id="kXSL">Your steps</span><span class="k-l" id="kXPn" aria-live="polite"></span></div>
              <div class="k-xp" aria-hidden="true"><i id="kXPb"></i></div>
              <div id="kXSteps" role="group" aria-labelledby="kXSL"></div>
            </div>
            <div class="k-x k-play" id="kPlay" hidden>
              <div class="k-l">Do it here</div>
              <div id="kPlayB"></div>
              <p class="k-l k-s">Optional: your taps write the start of your answer below. Finish it in your own words.</p>
            </div>
            <div class="k-compose" id="kCompose">
              <div class="k-brandnote" id="kBrandNote" hidden><p class="k-l k-s" id="kBrandFrom"></p><ul><li class="k-l k-s">If you choose to send your answer, they see only that answer, never your email or your other answers.</li><li class="k-l k-s">You decide each time, and saying no changes nothing.</li><li class="k-l k-s">Sending isn't active yet: this is a sample.</li></ul></div>
              <label class="k-l" for="kTa">Your answer</label>
              <textarea id="kTa" rows="4" maxlength="2000" aria-describedby="kLen"></textarea>
              <p class="k-rf-note" id="kLen">2–3 lines is enough.</p>
              <p class="k-rf-note" id="kSaved" aria-live="polite">It stays on this device unless you ask Slash.</p>
              <div class="k-x" id="kRun" hidden>
                <div class="k-xbtns"><button type="button" class="k-chipb" id="kRunB" aria-describedby="kRunN">Try your prompt on the AI</button></div>
                <p class="k-l k-s" id="kRunN">Sends only your prompt to the AI. Nothing is saved.</p>
                <div class="k-xex" id="kRunO" aria-live="polite" hidden><div class="k-l">What the AI made of it</div><pre id="kRunT"></pre></div>
              </div>
              <div class="k-sh-btns"><button type="button" class="k-go" id="kSub">Submit answer</button><button type="button" class="k-sk" id="kCancel">Not now</button></div>
            </div>
            <div class="k-x" id="kShH">
              <p class="k-l k-s" id="kXDemo" hidden>Demo: the question you ask Slash, with your draft, is sent to the AI to get a reply. We do not store it.</p>
              <div class="k-xbtns" id="kXBtns"><button type="button" class="k-chipb" id="kXHint">Need a hint?</button><button type="button" class="k-chipb k-ai-btn" id="kXAsk">Ask Slash</button><button type="button" class="k-chipb" id="kXEasy">Make it easier</button><button type="button" class="k-chipb" id="kXHard" aria-expanded="false" aria-controls="kXHardT">Make it harder</button></div>
              <p class="k-msg k-hard" id="kXHardT" hidden></p>
              <div id="kXHints" aria-live="polite"></div>
            </div>
            <div class="k-trailsigns" id="kShSB" hidden><div class="k-l">Tips from people before you</div><div id="kShS"></div></div>
          </div>
          <div class="k-step k-drop" id="kShD" hidden>
            <div class="k-dr-stage"><div class="k-dr-bits" id="kDrBits" aria-hidden="true"></div><div class="k-dr-art" id="kDrArt"></div></div>
            <div class="k-l" id="kDrL">You found</div>
            <h5 id="kDrT"></h5>
            <p class="k-dr-n" id="kDrN" aria-live="polite"></p>
            <div class="k-dr-path k-path" id="kDrPath" aria-hidden="true"></div>
            <p class="k-l" id="kDrS"></p>
            <p class="k-dr-nx" id="kDrNx" hidden></p>
            <p class="k-l k-s k-dr-tw" id="kDrTw" hidden></p>
            <div class="k-make-host" id="kMakeD" hidden></div>
            <div class="k-sh-btns"><button type="button" class="k-go" id="kDrOk" aria-describedby="kDrT kDrN kDrS kDrNx">Keep going</button><button type="button" class="k-sk" id="kDrCoop" aria-describedby="kDrCoN" hidden>Finish it with a friend</button><button type="button" class="k-sk" id="kDrDare" hidden>Dare someone to try it</button></div>
            <p class="k-l" id="kDrCoN" hidden>The link carries your answer, so it is only as private as the chat you send it to.</p>
            <div class="k-dr-more" id="kDrMore" hidden><button type="button" class="k-lnk" id="kDrTry"></button><button type="button" class="k-lnk" id="kDrRem">Remind me weekly</button></div>
          </div>
          <div class="k-step" id="kShR" hidden>
            <div class="k-xbtns" id="kVsAsk" hidden><button type="button" class="k-chipb" id="kVsGo" aria-expanded="false" aria-controls="kVs">See a strong answer</button><button type="button" class="k-chipb" id="kVsNo">Good enough, next</button></div>
            <div class="k-vs" id="kVs" hidden>
              <div class="k-vs-y"><div class="k-l">Yours</div><p id="kVsY"></p></div>
              <div class="k-xex" id="kXExB"><div class="k-l">One strong answer</div><pre id="kXExT"></pre></div>
              <p class="k-l k-s">Not a grade. Spot one thing you would try next time.</p>
            </div>
            <div id="kRfBar" hidden>
              <div class="k-l" id="kRfBL">Does yours do this?</div>
              <div id="kRfBI" role="group" aria-labelledby="kRfBL"></div>
              <p class="k-l k-s" id="kRfBN" aria-live="polite"></p>
            </div>
            <div class="k-l">Quick reflection · 20 seconds</div>
            <p class="k-q" id="kRfEQ">How did it feel?</p>
            <div class="k-chips" id="kRfE" role="group" aria-labelledby="kRfEQ"><span role="button" tabindex="0" data-v="flow">Time flew</span><span role="button" tabindex="0" data-v="ok">It was fine</span><span role="button" tabindex="0" data-v="drag">It dragged</span><span role="button" tabindex="0" data-v="easy">Too easy</span></div>
            <p class="k-q" id="kRfAQ">Would you do this kind of task again?</p>
            <div class="k-chips" id="kRfA" role="group" aria-labelledby="kRfAQ"><span role="button" tabindex="0" data-v="yes">Yes</span><span role="button" tabindex="0" data-v="maybe">Maybe</span><span role="button" tabindex="0" data-v="no">No</span></div>
            <label class="k-l" for="kRfH">Hardest part (optional)</label><input id="kRfH" type="text" maxlength="140" autocomplete="off" />
            <label class="k-l" for="kRfT">Leave a tip for the next person (optional)</label><input id="kRfT" type="text" maxlength="140" autocomplete="off" aria-describedby="kRfN" /><p class="k-rf-note" id="kRfN"></p>
            <div class="k-sh-btns"><button type="button" class="k-go" id="kRfOk">Save</button><button type="button" class="k-sk" id="kRfSkip">Skip</button></div>
          </div>
        </div>
      </div>

      <div class="k-sheet" id="kSet" role="dialog" aria-modal="true" aria-labelledby="kSetT" hidden>
        <div class="k-sh-in">
          <div class="k-grab" aria-hidden="true"></div>
          <div class="k-sethd k-top-zone"><h5 id="kSetT">Settings</h5><button type="button" class="k-shx" id="kSetX" aria-label="Close"><svg class="k-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
          <div class="k-prefs">
          <div class="k-row"><label class="k-l" id="kLgL" for="kLang">Language</label><select class="k-select" id="kLang"><option value="en" lang="en">English</option><option value="it" lang="it">Italiano</option><option value="de" lang="de">Deutsch</option><option value="fr" lang="fr">Français</option><option value="nl" lang="nl">Nederlands</option><option value="sv" lang="sv">Svenska</option></select></div>
          <div class="k-row"><span class="k-l" id="kTxL">Text size</span><div class="k-seg k-txt" role="group" aria-labelledby="kTxL"><button type="button" data-k-text="0" aria-label="Small">A</button><button type="button" data-k-text="1" aria-label="Default">A</button><button type="button" data-k-text="2" aria-label="Large">A</button><button type="button" data-k-text="3" aria-label="Larger">A</button></div></div>
          </div>
          <div class="k-acct" id="kAcct" hidden>
            <span class="k-l">Account</span>
            <p id="kAcctE">Not signed in · your answers are only on this device</p>
            <div class="k-btnrow">
              <button type="button" class="k-ask-btn" id="kAcctUp">Create an account to keep your answers</button>
              <button type="button" class="k-ask-btn" id="kLogout" hidden>Log out</button>
            </div>
          </div>
          <div class="k-set-list">
            <button type="button" class="k-ask-btn" data-k-send>Send my answers to the slashkern team</button>
            <button type="button" class="k-ask-btn" data-k-copy="app">Copy app link</button>
            <button type="button" class="k-ask-btn" id="kRemind">Add a weekly reminder to my calendar</button>
            <button type="button" class="k-ask-btn" id="kInst" hidden>Install slashkern</button>
            <p class="k-l" id="kIos" hidden>On iPhone: tap Share, then Add to Home Screen.</p>
          </div>
          <div class="k-set-list">
            <button type="button" class="k-ask-btn" id="kChField">Your interests</button>
            <button type="button" class="k-ask-btn" id="kFeed">Send feedback</button>
            <button type="button" class="k-ask-btn" id="kStatSet" hidden>Usage counts: off</button>
            <button type="button" class="k-ask-btn" id="kExp">Export my data</button>
            <a class="k-ask-btn" id="kKeepS" href="/privacy/#keep">What we keep</a>
          </div>
          <div class="k-set-list">
            <button type="button" class="k-ask-btn" id="kHelpS" data-k-help aria-expanded="false" aria-controls="kHelpST">Need to talk to someone now?</button>
            <p class="k-l k-s" id="kHelpST" hidden></p>
          </div>
          <div class="k-set-list">
            <button type="button" class="k-ask-btn k-danger" id="kDel">Delete my data</button>
            <button type="button" class="k-ask-btn k-danger" id="kDelAcc" hidden>Delete my account</button>
          </div>
          <div class="k-foot"><p class="k-l">Brand projects are samples for now.</p><p class="k-l"><a href="/about/">About</a> · <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · slashkern 1.0</p></div>
        </div>
      </div>

      <div class="k-sheet" id="kFld" role="dialog" aria-modal="true" aria-labelledby="kFlT" hidden>
        <div class="k-sh-in">
          <div class="k-grab" aria-hidden="true"></div>
          <div class="k-fl-h k-top-zone"><span class="k-fl-i" id="kFlI" aria-hidden="true"></span><div><div class="k-l">What to expect</div><h5 id="kFlT"></h5></div></div>
          <div class="k-l">A day in it</div>
          <p class="k-fl-day" id="kFlD"></p>
          <div class="k-fl-cols">
            <div><div class="k-l">People like</div><ul id="kFlL"></ul></div>
            <div><div class="k-l">People find hard</div><ul id="kFlH"></ul></div>
          </div>
          <p class="k-l">First impressions from the projects, not a verdict.</p>
          <button type="button" class="k-go" id="kFlGo">Try the next project</button>
          <button type="button" class="k-sk" id="kFlX">Close</button>
        </div>
      </div>

      <div class="k-sheet" id="kPwS" role="dialog" aria-modal="true" aria-labelledby="kPwT" hidden>
        <form class="k-sh-in" id="kPwF" novalidate>
          <div class="k-grab" aria-hidden="true"></div>
          <h5 id="kPwT" class="k-top-zone">Set a new password</h5>
          <div class="k-field"><label class="k-l" for="kPwN">New password</label><input id="kPwN" type="password" minlength="8" maxlength="72" autocomplete="new-password" /></div>
          <p class="k-err" id="kPwErr" role="alert" hidden></p>
          <button type="submit" class="k-go">Save password</button>
        </form>
      </div>

      <div class="k-sheet" id="kMicS" role="dialog" aria-modal="true" aria-labelledby="kMicT" hidden>
        <div class="k-sh-in">
          <div class="k-grab" aria-hidden="true"></div>
          <h5 id="kMicT" class="k-top-zone">Before you talk</h5>
          <p>Your browser turns your voice into text. Depending on your browser, the audio may go to its maker (Google or Apple). slashkern never records or stores audio.</p>
          <div class="k-sh-btns"><button type="button" class="k-go" id="kMicOk">Continue</button><button type="button" class="k-sk" id="kMicNo">Cancel</button></div>
        </div>
      </div>

      <div class="k-reward" id="kReward" role="dialog" aria-modal="true" aria-labelledby="kRwT" hidden>
        <div class="k-conf" id="kConf" aria-hidden="true"></div>
        <div class="k-rw-in">
          <div class="k-medal" aria-hidden="true">#1</div>
          <div class="k-l">Voted first</div>
          <h4 id="kRwT">Your answer<br>won <b>#1.</b></h4>
          <p>Preview: this is what it looks like when reviewers rank your answer first.</p>
          <div class="k-gain"><b id="kGain">+0</b> <span class="k-l">stones</span></div>
          <div class="k-rankup" id="kRU" hidden><div><div class="k-l">New rank</div><div class="k-rank" id="kRU2"></div></div></div>
          <button type="button" class="k-go" id="kRwOk">Keep going</button>
        </div>
      </div>

      <div class="k-start" id="kLogin">
        <form class="k-sp" id="kProf" novalidate>
          <div class="k-brandrow"><span class="k-mark" set:html={MARK} /><span class="k-wm">slashkern</span></div>
          <div class="k-l">Welcome</div>
          <h4>Save your<br><b>progress.</b></h4>
          <div class="k-seg k-authseg" id="kAuthSeg" role="group" aria-label="Account" hidden><button type="button" data-k-mode="up">Create account</button><button type="button" data-k-mode="in">Log in</button></div>
          <div class="k-field" id="kFName"><label class="k-l" for="kNmI">Your name</label><input id="kNmI" type="text" maxlength="40" autocomplete="given-name" aria-required="true" /></div>
          <div class="k-field" id="kFEmail" hidden><label class="k-l" for="kEm">Email</label><input id="kEm" type="email" maxlength="254" autocomplete="email" inputmode="email" aria-required="true" /></div>
          <div class="k-field" id="kFPw" hidden><label class="k-l" for="kPw">Password</label><input id="kPw" type="password" minlength="8" maxlength="72" autocomplete="new-password" aria-required="true" /></div>
          <label class="k-check" id="kFAge"><input type="checkbox" id="kAge" aria-required="true" /><span>I am 18 or older</span></label>
          <p class="k-err" id="kErr" role="alert" hidden></p>
          <p class="k-okm" id="kOk" role="status" hidden></p>
          <button type="submit" class="k-go" id="kLog">Start</button>
          <button type="button" class="k-sk" id="kForgot" hidden>Forgot password?</button>
          <button type="button" class="k-sk" id="kGuest" hidden>Continue without an account</button>
          <p class="k-l" id="kNoteLocal">No account needed. Your answers stay on this device. What you write to Slash goes to our AI provider to get a reply. <a href="/privacy/#keep">What we keep</a></p>
          <p class="k-l" id="kNoteCloud" hidden>Your answers are saved to your account and synced across your devices. <a href="/privacy/">Privacy</a></p>
        </form>
      </div>

      <div class="k-start k-first" id="kFirst" role="dialog" aria-modal="true" aria-labelledby="kF0H">
        <div class="k-fh">
          <button type="button" class="k-fback" id="kFBack" aria-label="Back" hidden><svg class="k-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"/></svg></button>
          <span class="k-l k-fn" id="kFNum">1 of 4</span>
          <button type="button" class="k-aa" id="kAa" aria-label="Text size">Aa</button>
        </div>

        <section class="k-fs k-f0" id="kF0">
          <div class="k-brandrow"><span class="k-mark" set:html={MARK_REV} /><span class="k-wm">slashkern</span></div>
          <h4 id="kF0H">Make something companies can hire you for.</h4>
          <p class="k-sub">Short projects. No experience needed. Slash, an AI that helps you make it.</p>
          <button type="button" class="k-go k-accb" id="kF0Go">Start</button>
        </section>

        <section class="k-fs" id="kF1" hidden>
          <div class="k-fgh"><h4 id="kF1H">Pick one to try</h4></div>
          <p class="k-l k-s" id="kF1P">Free practice projects.</p>
          <div class="k-fscroll" id="kF1S">
          <div class="k-projs" id="kF1L" role="group" aria-labelledby="kF1H"></div>
          <p class="k-l k-s" id="kF1Note">No account needed. Your answers stay on this device. What you write to Slash goes to our AI provider to get a reply. <a href="/privacy/#keep">What we keep</a></p>
          </div>
          <div class="k-ffoot">
            <label class="k-check" id="kF1Age"><input type="checkbox" id="kFirstAge" aria-describedby="kFirstAgeWhy" /><span>I am 18 or older</span></label>
            <p class="k-l k-s" id="kFirstAgeWhy">slashkern is for 18+ for now, because it is built for adults and keeps your answers.</p>
            <button type="button" class="k-go" id="kF1Go" aria-describedby="kF1Why">Continue</button>
            <p class="k-l k-s" id="kF1Why" aria-live="polite" hidden></p>
          </div>
        </section>

        <section class="k-fs" id="kF2" hidden>
          <div class="k-prog k-fprog" id="kFProg" role="progressbar" aria-label="Project progress" aria-valuemin="1" aria-valuemax="3" aria-valuenow="1"><i><b></b></i><i><b></b></i><i><b></b></i></div>
          <div class="k-l" id="kF2L"></div>
          <h5 id="kF2T"></h5>
          <div class="k-fprice" id="kF2P" hidden></div>
          <h4 class="k-fq" id="kF2Q" tabindex="-1"></h4>
          <label class="k-sr k-l" for="kF2Ta">Your answer</label>
          <textarea id="kF2Ta" rows="4" maxlength="600"></textarea>
          <button type="button" class="k-go" id="kF2Next">Next</button>
          <details class="k-brief" id="kF2D">
            <summary>See the brief</summary>
            <p class="k-fbrief" id="kF2B"></p>
            <div id="kF2M"></div>
          </details>
          <button type="button" class="k-lnk" id="kF2Ask" aria-expanded="false" aria-controls="kF2C">Ask Slash</button>
          <div class="k-fcoach" id="kF2C" aria-live="polite" hidden></div>
        </section>

        <section class="k-fs" id="kF3" hidden>
          <div class="k-saved" id="kF3Card"><span class="k-okdisc" aria-hidden="true" set:html={icon('done', 'k-i k-done-i')} /><div><div class="k-l" id="kF3Pg">Your page</div><b id="kF3Ttl"></b></div></div>
          <h4 id="kF3H" tabindex="-1">Saved to your page</h4>
          <p id="kF3P">Your first project is on your page. Companies join soon. Early creators are shown first.</p>
          <div class="k-make-host" id="kMakeF" hidden></div>
          <button type="button" class="k-go" id="kF3Go">See my page</button>
        </section>
      </div>

      <div class="k-start" id="kStart" role="dialog" aria-modal="true" aria-labelledby="kS2H">
        <div id="kS2" class="k-sp">
          <div class="k-l" id="kS2K">Your interests</div>
          <h4 id="kS2H">What are you<br>curious about <b>right now?</b></h4>
          <p class="k-l k-s" id="kPickL">Pick one or more. You can add others anytime.</p>
          <div class="k-tiles" id="kPick" role="group" aria-labelledby="kPickL">
            {FIELDS.map(([f, line]) => <button type="button" class="k-tile" data-f={f} aria-pressed="false"><span class="k-ti" aria-hidden="true" set:html={icon(f)} /><span>{f}</span><small>{line}</small></button>)}
          </div>
          <div id="kPaths"><p class="k-l k-s">Seven creative and digital paths, for now.</p><p class="k-l k-s">Projects are set in Italy. Most are text; a few have real sound and clips.</p></div>
          <label class="k-check" id="kS2Age" hidden><input type="checkbox" id="kAge2" aria-describedby="kAgeWhy" /><span>I am 18 or older</span></label>
          <p class="k-l k-s" id="kAgeWhy" hidden>slashkern is for 18+ for now, because it is built for adults and keeps your answers.</p>
          <button type="button" class="k-go" id="kGo" aria-describedby="kGoWhy">Save interests</button>
          <p class="k-l k-s" id="kGoWhy" aria-live="polite" hidden></p>
          <p class="k-l k-s" id="kS2Note" hidden>No account needed. Your answers stay on this device. What you write to Slash goes to our AI provider to get a reply. <a href="/privacy/#keep">What we keep</a></p>
          <button type="button" class="k-sk" id="kPickX" hidden>Not now</button>
        </div>
      </div>

      <div class="k-app">
        <header class="k-top">
          <div class="k-logo"><span class="k-lgw" set:html={MARK} />slashkern</div>
          <div class="k-tp"><button type="button" class="k-demo" id="kDemo" aria-label="Demo profile with sample data. Tap to leave the demo." hidden>Demo</button><span class="k-pill"><i class="k-ring" id="kRing" aria-hidden="true"></i><span id="kPill">0 of 3 done</span></span><button type="button" class="k-av" id="kAv" aria-label="Settings" aria-haspopup="dialog">K</button></div>
        </header>
        <div class="k-body">
          <section class="k-pane on" id="k-missions">
            <div class="k-hero">
              <div class="k-l" id="kHi">Hi</div>
              <div class="k-hero-row"><span class="k-l" id="kPathL">Your path</span><button type="button" class="k-lnk k-more" id="kMore" aria-expanded="false" aria-controls="kMoreBox">More paths</button></div>
              <h4 id="kPathN">Video</h4>
              <div class="k-morebox" id="kMoreBox" hidden>
                <div class="k-fields" id="kFields" role="group" aria-label="Your interests"></div>
                <button type="button" class="k-sk k-about" id="kAbout" aria-haspopup="dialog"></button>
              </div>
            </div>
            <div class="k-streak k-cut" id="kStreak" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c1 4 5 5 5 10a5 5 0 0 1-10 0c0-2 1-3 2-4 0 2 1 3 2 3 0-3-1-6 1-9z"/></svg><b id="kStreakT"></b><small>A missed day is forgiven.</small></div>
            <div class="k-card k-coop" id="kCoop" hidden>
              <div class="k-l" id="kCoL"></div>
              <h5 id="kCoT"></h5>
              <div class="k-coq"><div class="k-l" id="kCoQL"></div><p id="kCoQ"></p></div>
              <div class="k-l">Your part</div>
              <p id="kCoAsk"></p>
              <label class="k-sr" for="kCoTa">Your reply</label>
              <textarea id="kCoTa" rows="3" maxlength="300"></textarea>
              <div class="k-btnrow"><button type="button" class="k-go" id="kCoSend">Send back</button><button type="button" class="k-sk" id="kCoSelf">Do the project yourself</button><button type="button" class="k-sk" id="kCoNo">Not now</button></div>
            </div>
            <div class="k-card k-dare" id="kDare" hidden><div class="k-l">A friend dared you</div><h5 id="kDareT"></h5><button type="button" class="k-go" id="kDareGo">Answer the dare</button></div>
            <div class="k-card k-main" id="kNext"><div class="k-stg"><b aria-hidden="true">1</b><span class="k-l">Make</span></div><span class="k-nxic" id="kNxIc" aria-hidden="true"></span><div class="k-l" id="kNxL">Your next step</div><div class="k-path k-nx-path" id="kNxPath" aria-hidden="true"></div><h5 id="kNxT">Fix what already exists</h5><p id="kNxP">Make a real startup's onboarding screen clearer. The opposite of starting from a blank page.</p><div class="k-meta" id="kNxM"></div><div class="k-boost-chip" id="kNxB" hidden></div><button type="button" class="k-btn" id="kAdd">Start project</button><button type="button" class="k-sk" id="kAdd2" hidden></button></div>
            <div class="k-card"><div class="k-l" id="kMsL">Your 3 projects</div>
              <div class="k-mlist">
                <button type="button" class="k-mrow" id="kMR0"><i class="k-mdot" aria-hidden="true"></i><span><b>Fix what already exists</b><small></small></span><em aria-hidden="true">›</em></button>
                <button type="button" class="k-mrow" id="kMR1"><i class="k-mdot" aria-hidden="true"></i><span><b>Rewrite a confusing email</b><small></small></span><em aria-hidden="true">›</em></button>
                <button type="button" class="k-mrow" id="kMR2"><i class="k-mdot" aria-hidden="true"></i><span><b>Work with a partner</b><small></small></span><em aria-hidden="true">›</em></button>
              </div>
              <button type="button" class="k-sk k-peek" id="kPeek" hidden></button>
            </div>
            <div class="k-card k-trend" id="kTrend">
              <h5 id="kTrendH">Trending now</h5>
              <p class="k-l k-s">Seen Aug to Oct 2026. Trends move fast.</p>
              <div class="k-shelf" id="kTrendL" role="group" aria-labelledby="kTrendH"></div>
            </div>
            <div class="k-card k-stage" id="kKeep">
              <div class="k-stg"><b aria-hidden="true">2</b><span class="k-l">Keep</span></div>
              <p class="k-stl">Your page fills itself with finished projects.</p>
              <p class="k-l k-s" id="kKeepN">Nothing on your page yet.</p>
              <button type="button" class="k-ask-btn" id="kToPage">See my page</button>
            </div>
            <div class="k-card k-stage k-lockd" id="kFound">
              <div class="k-stg"><b aria-hidden="true">3</b><span class="k-l">Get found</span><span class="k-lk" id="kFoundS">Locked</span></div>
              <p class="k-stl">When companies post briefs, you can apply. The company chooses who gets the project and pays them.</p>
              <div class="k-xp k-fbar" aria-hidden="true"><i id="kFoundB"></i></div>
              <p class="k-l k-s" id="kFoundN"></p>
            </div>
            <div class="k-card k-fnd" id="kFind">
              <h5>How companies will find you</h5>
              <div class="k-fnd-r"><p class="k-l">Who sees your projects?</p><p>Companies will see the projects you choose to publish on your page.</p></div>
              <div class="k-fnd-r"><p class="k-l">What is public?</p><p>You decide. Nothing is shared until you choose.</p></div>
              <p class="k-fnd-n">Nobody is paying yet: this is early access.</p>
            </div>
            <div class="k-card k-stat" id="kStat" hidden><div class="k-l">Help improve slashkern</div><p>Count my progress, without my name? We only see which projects you open and finish, when you come back, and whether you use Share or Slash. Never your name, your answers or your email.</p><div class="k-btnrow"><button type="button" class="k-ask-btn" id="kStY">Yes, count me in</button><button type="button" class="k-ask-btn" id="kStN">No thanks</button></div><div><a class="k-l" href="/privacy/">What is counted?</a></div></div>
            <div class="k-card k-habit k-cut" id="kHabit">
              <div class="k-l k-finds-h"><span>Daily habit · tiny on purpose</span><span id="kHbN"></span></div>
              <div id="kHbSet">
                <h5>Start one tiny habit</h5>
                <p>Make it so small you cannot fail. Tie it to something you already do every day, and it sticks.</p>
                <div class="k-chips" id="kHbPick"></div>
                <label class="k-l" for="kHbT">Your tiny habit</label><input id="kHbT" type="text" maxlength="60" autocomplete="off" />
                <div class="k-chips" id="kHbCues"></div>
                <label class="k-l" for="kHbC">Right after I…</label><input id="kHbC" type="text" maxlength="60" autocomplete="off" />
                <button type="button" class="k-btn" id="kHbSave">Start my habit</button>
              </div>
              <div id="kHbRun" hidden>
                <h5 id="kHbName"></h5>
                <p id="kHbCue"></p>
                <div class="k-hb-dots" id="kHbDots" role="group" aria-label="Last 7 days"></div>
                <div class="k-sh-btns"><button type="button" class="k-go" id="kHbDo">I did it</button><button type="button" class="k-sk" id="kHbEdit">Change habit</button></div>
                <p class="k-l" id="kHbMsg" aria-live="polite"></p>
              </div>
            </div>
            <div class="k-card k-best k-cut"><div class="k-l">Coming with partner projects</div><h5>Anonymous review</h5><p>Reviewers rank answers by quality, not likes. The best ones get seen by the company behind the project.</p><button type="button" class="k-win" id="kWin">See what a win feels like</button></div>
            <div class="k-card k-aic"><span class="k-ci" aria-hidden="true" set:html={icon('copilot')} /><div class="k-l">Stuck?</div><p>Slash asks the questions that get you moving. It never gives you the answer.</p><button type="button" class="k-ask-btn" id="kToAi">Open Slash</button></div>
          </section>

          <section class="k-pane" id="k-yourkern">
            <div><div class="k-l">Your page</div><h4>Your <b>page.</b></h4><p class="k-l k-s k-yk-why" id="kYkWhy">Your page keeps the projects you finish. Your Slash card is built from them and from your reflections.</p><p class="k-early">Early access: companies join soon. Early creators are shown first.</p></div>
            <div class="k-card" id="kPages"><div class="k-l">Your projects</div><div id="kAns"></div></div>
            <div class="k-card k-kcard" id="kSlashCard"><div class="k-l">Your Slash card</div><div class="k-kc">
                <div class="k-kc-top"><div class="k-kt"><span class="k-lgw" set:html={MARK_REV} />slashkern</div><span class="k-l" id="kCardF">Writing</span></div>
                <div class="k-kc-path" id="kCardP" aria-hidden="true"><i class="on"></i><i class="on"></i><i class="on"></i><i></i><i></i><i></i></div>
                <span class="k-l k-kc-n" id="kCardN">3 of 6 projects</span>
                <p class="k-kc-q" id="kCardQ">Almost stayed home. Bag strap snapped on the bus. Lifted 40 kg anyway.</p>
                <p class="k-kc-m" id="kCardM">Rewrite a caption so friends reply · Time flew</p>
                <h5 id="kCardH">So far, you get into it when you start from zero.</h5>
                <div class="k-l k-kc-l" id="kCardL">Example · answer and reflect to make it yours</div>
              </div>
              <p class="k-l k-s" id="kWhy" hidden>Why we think so: you tried 3 versions of the open brief, and you wrote "time flew".</p>
              <div class="k-ask" id="kCardAsk" hidden><button type="button" class="k-yes" data-k-fit="yes" aria-pressed="false">That feels right</button><button type="button" data-k-fit="no" aria-pressed="false">Not really</button></div><div class="k-l k-fb" id="kFb" aria-live="polite"></div>
              <div class="k-btnrow"><button type="button" class="k-ask-btn" data-k-share="card">Share my card</button><button type="button" class="k-ask-btn" data-k-copy="app">Copy app link</button></div></div>
            <div class="k-l k-s k-note" id="kSample">This card is an example until you finish a project and reflect.</div>
            <div class="k-card" id="kMeterC" hidden><div class="k-l">What you light up on</div><div class="k-meter" id="kMeter"></div><p class="k-l k-s" id="kMeterN">From your reflections. Not a test.</p></div>
            
            <div class="k-card k-further" id="kFurther" hidden><div class="k-l" id="kFuL"></div><h5>Three steps outside the app</h5><ol class="k-fu" id="kFuO"></ol><p class="k-l k-s">Small and free. Pick one this week.</p></div>
            <div class="k-card" id="kFcmp" hidden><div class="k-l">Fields side by side</div><h5 id="kFcmpT"></h5><div class="k-meter" id="kFcmpM"></div><p class="k-l k-s">Energy from how it felt, and how many reflections it rests on. Your own answers, not a test.</p></div>
            <div class="k-card" id="kCoops" hidden><div class="k-l">Co-op with a friend</div><p>Two projects in every field work with a friend. Answer one, send the link, and read both answers here.</p><div id="kCoopL"></div></div>
            <div class="k-card k-lvl k-cut"><div class="k-lvl-top"><div><div class="k-l">Your rank</div><div class="k-rank" id="kRank">Pebble</div></div><div class="k-stones"><b id="kSt">0</b> <span class="k-l">stones</span></div></div><div class="k-bar k-bar-g"><i id="kBar"></i></div><small class="k-nx" id="kNx"></small><div class="k-ladder" id="kLad"></div></div>
            <!-- Cut in v3 (they repeated the card): the first guess, what you seem drawn to, the AI signal. Kept in the code, like the other k-cut pieces. -->
            <div class="k-card k-cut"><div class="k-l">A first guess</div><div class="k-sig" id="kGuess">You seemed to light up on the open brief and drag on the polish.</div></div>
            <div class="k-card k-cut"><div class="k-l">What you seem drawn to</div><div class="k-chips" id="kDrawn"><span>Shaping ideas</span><span>Writing</span><span>Solo work</span></div></div>
            <div class="k-card k-cut"><div class="k-l">Your idea with Slash</div><div class="k-sig" id="kAiSig">You rewrote your question 4 times, and every version got clearer.</div></div>
            <div class="k-card k-cut"><div class="k-l k-finds-h"><span>Finds</span><span id="kFN"></span></div><div class="k-finds" id="kFinds"></div><p class="k-l">Finish projects to uncover them. You never know which one drops.</p></div>
            <div class="k-card k-cut"><div class="k-l" id="kBdL">Badges</div><div class="k-badges" id="kBadges" role="group" aria-labelledby="kBdL"></div></div>
            <div class="k-duo k-cut"><div class="k-card"><div class="k-l">Answers made</div><div class="k-stat"><b id="kCnt">0</b></div><span class="k-l">on this device · only you see this</span></div><div class="k-card"><div class="k-l">Your rhythm · no pressure</div><div class="k-cal" id="kDots" aria-hidden="true"></div><p id="kRhy"></p></div></div>
            <div class="k-card k-signs-card" id="kSignsC" hidden><div class="k-l">Tips you left</div><p id="kSignsN"></p><div id="kSigns"></div></div>
            <div class="k-card"><div class="k-l">Dare a friend</div><p>Send a project to a friend, and answer it on your own. For two answers side by side, use a co-op project.</p><div class="k-btnrow"><button type="button" class="k-ask-btn" data-k-share="dare">Send a dare</button><button type="button" class="k-ask-btn" data-k-copy="dare">Copy link</button></div></div>
            <div class="k-card k-pilot k-cut"><div class="k-l">Testing slashkern?</div><p>Send your answers and reflections to the team. It helps us build the next version.</p><button type="button" class="k-ask-btn" data-k-send>Send my answers to the slashkern team</button></div>
                      </section>

          <section class="k-pane" id="k-trail" hidden>
            <div class="k-hd"><div class="k-l">Your Trail</div><h4>Follow the<br><b>trail.</b></h4></div>
            <div class="k-tr" id="kTr" role="list">
              <div class="k-st" role="listitem"><h5 id="kTr0">Fix what already exists</h5><p>Not started</p></div>
              <div class="k-st" role="listitem"><h5 id="kTr1">Rewrite a confusing email</h5><p>Not started</p></div>
              <div class="k-st" role="listitem"><h5 id="kTr2">Work with a partner</h5><p>Not started</p></div>
              <div class="k-st" id="kTrK" role="listitem"><h5>Your Slash card</h5><p>Ready when your 3 projects are done</p></div>
            </div>
          </section>

          <section class="k-pane" id="k-copilot">
            <div class="k-hd"><div class="k-l">Slash · AI</div><h4>Your idea.<br>My <b>questions.</b></h4></div>
            <div class="k-ait"><span class="k-slash-av k-slash-lg" aria-hidden="true" set:html={slash('neutral', true)} /><div class="k-l" id="kAiLbl">You are talking to an AI · live when online</div></div>
            <p class="k-l" id="kAiDemo" hidden>Demo: what you type here is sent to the AI to get a reply. We do not store it.</p>
            <p class="k-l k-s" id="kAiNote">What you write here goes to our AI provider to get a reply. slashkern doesn't keep it.</p>
            <div class="k-card k-chat">
              <div class="k-log" id="kChat"></div><div class="k-sr" id="kSr" role="status" aria-live="polite"></div>
              <div class="k-cmp" id="kCmp" hidden><div class="k-l">Version 1</div><p id="kV1"></p><div class="k-l">Version 3</div><p id="kV3"></p><button type="button" class="k-ask-btn" id="kSaveV">Save to your page</button></div>
              <div class="k-comp"><input id="kIn" type="text" maxlength="140" autocomplete="off" aria-label="Your idea" /><button type="button" class="k-send" id="kSend" aria-label="Send">↑</button></div>
              <div class="k-chips" id="kEx"><span role="button" tabindex="0">Use an example</span><span role="button" tabindex="0">Start over</span><span role="button" tabindex="0">I’m stuck</span><span role="button" tabindex="0">Make it smaller</span></div>
            </div>
            <div class="k-card k-cut"><div class="k-l">Do it twice</div><p>Make it alone first. Then with Slash. Compare the two.</p></div>
            <div class="k-card"><div class="k-l">The rules</div><p>It asks. It never answers.</p><p>Your idea always comes first.</p><p>If it gets heavy, it stops and points you to a person.</p><button type="button" class="k-lnk" id="kHelpA" data-k-help aria-expanded="false" aria-controls="kHelpAT">Need to talk to someone now?</button><p id="kHelpAT" hidden></p></div>
          </section>
        </div>
        <div class="k-toast" id="kToast" role="status" aria-live="polite"><span id="kToastT"></span><button type="button" id="kToastB" hidden>Undo</button></div>
        <nav class="k-tabs" aria-label="slashkern">
          <button type="button" class="on" data-k-tab="missions"><span class="ti" aria-hidden="true"><svg class="k-ti-i" viewBox="0 0 24 24" focusable="false"><rect x="4" y="4" width="7" height="7" rx="2"/><rect x="13" y="4" width="7" height="7" rx="2"/><rect x="4" y="13" width="7" height="7" rx="2"/><rect x="13" y="13" width="7" height="7" rx="2"/></svg></span><span class="tn tt">Projects</span></button>
          <button type="button" data-k-tab="yourkern"><span class="ti" aria-hidden="true"><svg class="k-ti-i" viewBox="0 0 24 24" focusable="false"><path d="M7 3.5h7l4 4V20a.5.5 0 0 1-.5.5h-10.5A.5.5 0 0 1 6.5 20V4a.5.5 0 0 1 .5-.5z"/><path d="M9.5 12h5M9.5 15.5h5"/></svg></span><span class="tn tt">Your page</span></button>
          <button type="button" data-k-tab="copilot"><span class="ti" aria-hidden="true"><svg class="k-ti-i" viewBox="0 0 24 24" focusable="false"><path d="M5 5.5h14a1 1 0 0 1 1 1V15a1 1 0 0 1-1 1h-7l-4 3.5V16H5a1 1 0 0 1-1-1V6.5a1 1 0 0 1 1-1z"/></svg></span><span class="tn tt">Slash</span></button>
        </nav>
      </div>
    </main>
    <noscript><p class="k-nojs">slashkern needs JavaScript to run.</p></noscript>
    <script>import '../scripts/app';</script>
  </body>
</html>
