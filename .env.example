# Copy to .env for local dev, and add the same two variables in Netlify:
# Site configuration > Environment variables. Both come from Supabase > Project Settings > API.
# The anon key is meant to be public; Row Level Security in supabase/schema.sql protects the data.
# Leave them empty to run KERN without accounts (everything stays on the device).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
